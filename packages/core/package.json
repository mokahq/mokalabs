{
  "name": "@mokalabs/core",
  "version": "0.2.0",
  "description": "Headless Moka engine: any LLM + MCP servers + skills, with a full event trace.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokahq/mokalabs.git",
    "directory": "packages/core"
  },
  "keywords": [
    "llm",
    "mcp",
    "model-context-protocol",
    "agent",
    "skills",
    "ai-sdk"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.52",
    "@ai-sdk/azure": "^4.0.68",
    "@ai-sdk/google": "^4.0.67",
    "@ai-sdk/openai": "^4.0.65",
    "@ai-sdk/openai-compatible": "^3.0.47",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "ai": "^7.0.97",
    "zod": "^4.6.2"
  }
}
