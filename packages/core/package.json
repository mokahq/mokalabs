{
  "name": "@mokalabs/core",
  "version": "0.5.0",
  "description": "Headless Moka engine: any LLM + MCP servers + skills, with a full event trace.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokahq/mokalabs.git",
    "directory": "packages/core"
  },
  "homepage": "https://mokalabs.dev/reference/core/",
  "bugs": {
    "url": "https://github.com/mokahq/mokalabs/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-client",
    "llm",
    "agent",
    "ai-agents",
    "skills",
    "ai-sdk",
    "tracing"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.80",
    "@ai-sdk/azure": "^4.0.102",
    "@ai-sdk/google": "^4.0.96",
    "@ai-sdk/openai": "^4.0.94",
    "@ai-sdk/openai-compatible": "^3.0.69",
    "@modelcontextprotocol/client": "^2.2.0",
    "ai": "^7.0.141",
    "zod": "^4.6.5"
  }
}
