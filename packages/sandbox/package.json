{
  "name": "@mokalabs/sandbox",
  "version": "0.2.0",
  "description": "Moka sandbox — chat with any LLM, plug in any MCP server or skill, and inspect every call. One command: npx @mokalabs/sandbox",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sandbox": "./dist/cli.js",
    "moka": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokahq/mokalabs.git",
    "directory": "packages/sandbox"
  },
  "homepage": "https://github.com/mokahq/mokalabs#readme",
  "keywords": [
    "llm",
    "mcp",
    "playground",
    "sandbox",
    "inspector",
    "agent",
    "skills",
    "openai",
    "anthropic",
    "ollama"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:server && node scripts/schema.mjs",
    "build:server": "tsup",
    "build:web": "vite build web --config web/vite.config.ts",
    "dev": "concurrently -k -n server,web \"tsx watch src/cli.ts --no-open --port 4000 --no-auth\" \"vite web --config web/vite.config.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.52",
    "@ai-sdk/azure": "^4.0.68",
    "@ai-sdk/google": "^4.0.67",
    "@ai-sdk/openai": "^4.0.65",
    "@ai-sdk/openai-compatible": "^3.0.47",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mokalabs/core": "workspace:^",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ai": "^7.0.97",
    "concurrently": "^9.2.0",
    "hono": "^4.13.7",
    "lucide-react": "^1.45.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "vite": "^8.3.0",
    "zod": "^4.6.2",
    "zustand": "^5.0.15"
  },
  "dependencies": {}
}
