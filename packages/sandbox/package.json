{
  "name": "@mokalabs/sandbox",
  "version": "0.5.0",
  "description": "See every MCP message: chat with any LLM and MCP server, compare models, call tools, and see what your AI editor sends to your MCP servers. 100% local. One command: npx @mokalabs/sandbox",
  "license": "MIT",
  "type": "module",
  "bin": {
    "sandbox": "./dist/cli.js",
    "moka": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mokahq/mokalabs.git",
    "directory": "packages/sandbox"
  },
  "homepage": "https://mokalabs.dev",
  "bugs": {
    "url": "https://github.com/mokahq/mokalabs/issues"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-client",
    "mcp-inspector",
    "llm",
    "ai-agents",
    "inspector",
    "debugging",
    "json-rpc",
    "playground",
    "sandbox",
    "generative-ui",
    "a2ui",
    "mcp-apps",
    "ag-ui",
    "a2a",
    "langgraph",
    "skills",
    "openai",
    "anthropic",
    "gemini",
    "azure",
    "ollama"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm run build:web && pnpm run build:server && node scripts/schema.mjs",
    "build:server": "tsup",
    "build:web": "vite build web --config web/vite.config.ts",
    "dev": "concurrently -k -n server,web \"tsx watch src/cli.ts --no-open --port 4000 --no-auth\" \"vite web --config web/vite.config.ts\"",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web",
    "test": "vitest run"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "^4.0.80",
    "@ai-sdk/azure": "^4.0.102",
    "@ai-sdk/google": "^4.0.96",
    "@ai-sdk/openai": "^4.0.94",
    "@ai-sdk/openai-compatible": "^3.0.69",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^2.1.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@mokalabs/core": "workspace:^",
    "@mokalabs/proxy": "workspace:^",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.1.1",
    "ai": "^7.0.141",
    "concurrently": "^10.0.5",
    "hono": "^4.13.7",
    "katex": "^0.16.47",
    "lucide-react": "^1.45.0",
    "mermaid": "^11.17.2",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.4.3",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
