+  const onAction = useActionToast();
+  const ws = config.workspaces.find((w) => w.id === workspaceId);
+
+  useEffect(() => {
+    playgroundDraft.text = text;
+    playgroundDraft.prompt = prompt;
+  }, [text, prompt]);
+
+  // Live preview, debounced.
+  useEffect(() => {
+    let input: unknown;
+    try {
+      input = JSON.parse(text);
+      setParseError(undefined);
