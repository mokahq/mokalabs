+  return (action: A2uiAction) => toast(`Action "${action.name}" · ${JSON.stringify(action.context)}`, "success");
+}
+
+/* ---------------------------------------------------------------- playground */
+
+interface PreviewResult {
+  messages: Array<Record<string, any>>;
+  problems: string[];
+  input?: unknown;
+  model?: string;
+  durationMs?: number;
+  error?: string;
+}
+
+function Playground() {
